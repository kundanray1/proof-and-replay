{
  "name": "proof-and-replay",
  "version": "0.3.0",
  "description": "A local-first evidence graph and replay ledger for AI-written code.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "proof-replay": "dist/cli.js"
  },
  "files": [
    "dist",
    "examples",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean --silent && tsc -p tsconfig.build.json && node ./dist/build/copy-static.js && node -e \"require('node:fs').rmSync('dist/build',{recursive:true,force:true})\" && esbuild ./src/ui/app.tsx --bundle --format=esm --target=es2022 --minify --sourcemap --outfile=./dist/ui/app.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "demo": "npm run build --silent && node ./dist/cli.js demo",
    "start": "npm run build --silent && node ./dist/cli.js serve",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm test",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check",
    "pack:check": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@11.11.0",
  "dependencies": {
    "typescript": ">=5.5 <7"
  },
  "keywords": [
    "ai-agents",
    "code-graph",
    "provenance",
    "replay",
    "testing"
  ],
  "author": {
    "name": "Kundan Ray",
    "email": "raykundan57@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kundanray1/proof-and-replay.git"
  },
  "homepage": "https://github.com/kundanray1/proof-and-replay#readme",
  "bugs": {
    "url": "https://github.com/kundanray1/proof-and-replay/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.25.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.20.0"
  }
}
